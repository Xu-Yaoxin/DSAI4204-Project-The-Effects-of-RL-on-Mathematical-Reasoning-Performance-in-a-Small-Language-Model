{
  "version": "1.2.0",
  "model": {
    "path": "models/Qwen3.5-2B-Base",
    "dtype": "bfloat16",
    "repo_id": "Qwen/Qwen3.5-2B-Base"
  },
  "prompt": {
    "template": "Solve the following math problem. Show your calculation, then give the final numerical answer on a separate line as #### <answer>.\n\nProblem: {question}\n\nSolution:\n"
  },
  "data": {
    "raw_train": "data/raw/gsm8k/train.jsonl",
    "raw_test": "data/raw/gsm8k/test.jsonl",
    "output_dir": "data/processed",
    "seed": 42,
    "engineering_size": 32,
    "pilot_size": 128,
    "train_size": 512,
    "dev_size": 200,
    "test_size": 200,
    "structural_family_count": 40,
    "structural_seed": 43
  },
  "training": {
    "seed": 42,
    "num_generations": 8,
    "temperature": 1.0,
    "top_p": 1.0,
    "lora_rank": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "learning_rate": 5e-06,
    "epochs": 3,
    "gradient_accumulation_steps": 32,
    "per_device_train_batch_size": 1,
    "max_completion_length": 512,
    "max_prompt_length": 768,
    "loss_type": "grpo",
    "beta": 0.0,
    "scale_rewards": "group",
    "epsilon": 0.2,
    "num_iterations": 1,
    "save_strategy": "epoch",
    "save_steps": 128,
    "logging_steps": 1,
    "max_grad_norm": 1.0,
    "steps_per_generation": 8
  },
  "evaluation": {
    "seed": 314159,
    "n_samples": 16,
    "dev_samples": 4,
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 0,
    "max_new_tokens": 512,
    "max_prompt_length": 768,
    "bootstrap_replicates": 2000
  }
}
